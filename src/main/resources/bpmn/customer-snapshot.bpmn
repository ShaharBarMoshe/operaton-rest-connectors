    <bpmn:parallelGateway id="join" name="All fetched">
      <bpmn:incoming>out_profile</bpmn:incoming>
      <bpmn:incoming>out_contact</bpmn:incoming>
      <bpmn:incoming>out_address</bpmn:incoming>
      <bpmn:incoming>out_account</bpmn:incoming>
