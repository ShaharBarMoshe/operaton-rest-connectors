    "self": "/api/customers/501/address"
  }
}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>in_address</bpmn:incoming>
      <bpmn:outgoing>out_address</bpmn:outgoing>
    </bpmn:serviceTask>
