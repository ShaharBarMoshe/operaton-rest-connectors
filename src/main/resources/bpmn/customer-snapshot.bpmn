      <bpmn:incoming>toPost</bpmn:incoming>
      <bpmn:outgoing>toEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Snapshot stored">
      <bpmn:incoming>toEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toFork" sourceRef="start" targetRef="fork" />
    <bpmn:sequenceFlow id="in_profile" sourceRef="fork" targetRef="getProfile" />
    <bpmn:sequenceFlow id="out_profile" sourceRef="getProfile" targetRef="join" />
    <bpmn:sequenceFlow id="in_contact" sourceRef="fork" targetRef="getContact" />
    <bpmn:sequenceFlow id="out_contact" sourceRef="getContact" targetRef="join" />
    <bpmn:sequenceFlow id="in_address" sourceRef="fork" targetRef="getAddress" />
    <bpmn:sequenceFlow id="out_address" sourceRef="getAddress" targetRef="join" />
    <bpmn:sequenceFlow id="in_account" sourceRef="fork" targetRef="getAccount" />
    <bpmn:sequenceFlow id="out_account" sourceRef="getAccount" targetRef="join" />
    <bpmn:sequenceFlow id="in_loyalty" sourceRef="fork" targetRef="getLoyalty" />
    <bpmn:sequenceFlow id="out_loyalty" sourceRef="getLoyalty" targetRef="join" />
    <bpmn:sequenceFlow id="toPost" sourceRef="join" targetRef="postSnapshot" />
    <bpmn:sequenceFlow id="toEnd" sourceRef="postSnapshot" targetRef="end" />
    <bpmn:subProcess id="errorHandler" name="Handle REST errors" triggeredByEvent="true">
      <bpmn:documentation>Catches every BPMN error thrown by a REST task of this process (error start event without an error code = catch all) and ends the instance at the end event for that kind of error. errorCode / errorMessage hold the code (HTTP_401, HTTP_404, HTTP_503, REQUEST_INVALID, CONNECTION_FAILED, ...) and the response body; callers get them with withVariablesInReturn. A boundary event on a task (e.g. HTTP_404 on the first GET) still takes precedence.</bpmn:documentation>
      <bpmn:startEvent id="errStart" name="Any REST error">
        <bpmn:outgoing>errFlowStart</bpmn:outgoing>
        <bpmn:errorEventDefinition id="errStartDef" camunda:errorCodeVariable="errorCode" camunda:errorMessageVariable="errorMessage" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="errKind" name="Which error?" default="errFlowRejected">
        <bpmn:incoming>errFlowStart</bpmn:incoming>
        <bpmn:outgoing>errFlowAuth</bpmn:outgoing>
        <bpmn:outgoing>errFlowNotFound</bpmn:outgoing>
        <bpmn:outgoing>errFlowInvalid</bpmn:outgoing>
        <bpmn:outgoing>errFlowUnavailable</bpmn:outgoing>
        <bpmn:outgoing>errFlowRejected</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="errEndAuth" name="Not authorized">
        <bpmn:incoming>errFlowAuth</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndNotFound" name="Not found">
        <bpmn:incoming>errFlowNotFound</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndInvalid" name="Invalid data">
        <bpmn:incoming>errFlowInvalid</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndUnavailable" name="Service unavailable">
        <bpmn:incoming>errFlowUnavailable</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndRejected" name="Request rejected">
        <bpmn:incoming>errFlowRejected</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="errFlowStart" sourceRef="errStart" targetRef="errKind" />
      <bpmn:sequenceFlow id="errFlowAuth" name="HTTP_401 / HTTP_403" sourceRef="errKind" targetRef="errEndAuth">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'HTTP_401' || errorCode == 'HTTP_403'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowNotFound" name="HTTP_404" sourceRef="errKind" targetRef="errEndNotFound">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'HTTP_404'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowInvalid" name="REQUEST_INVALID / RESPONSE_INVALID" sourceRef="errKind" targetRef="errEndInvalid">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'REQUEST_INVALID' || errorCode == 'RESPONSE_INVALID'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowUnavailable" name="HTTP_5xx / CONNECTION_FAILED" sourceRef="errKind" targetRef="errEndUnavailable">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'CONNECTION_FAILED' || errorCode.startsWith('HTTP_5')}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowRejected" name="other 4xx (default)" sourceRef="errKind" targetRef="errEndRejected" />
    </bpmn:subProcess>
  </bpmn:process>
