    <bpmn:serviceTask id="postSnapshot" name="POST merged snapshot" camunda:delegateExpression="${restPost}">
      <bpmn:documentation>[REST connector] REST POST - Create a resource: body built from merged sources + JSON Schema.
Implementation: delegateExpression ${restPost}
Inputs (leave empty when not needed):
- url: Request URL. Supports ${expressions} and {placeholders} that are filled from params with "x-in": "path". Example: ${apiBaseUrl}/users/{userId}
- sources: Comma separated process variable names (or a JSON literal) deep-merged in order - later wins. Example: currentUser, userChanges
- paramsSchema: Optional JSON Schema for path / query / header params ("x-in"), e.g. the {userId} path placeholder. Paste the JSON Schema itself (inline JSON object), not a file path. Use "x-expression": "varName" (no dollar-brace wrapper) for expressions - the engine evaluates any dollar-brace text in this field before the connector runs. Keep it under ~4000 characters (engine string-variable limit).
- bodySchema: JSON Schema that builds + validates the request body from the merged sources (x-source, x-expression, x-flatten, default, const). Empty = send the merged sources as-is. Paste the JSON Schema itself (inline JSON object), not a file path. Use "x-expression": "varName" (no dollar-brace wrapper) for expressions - the engine evaluates any dollar-brace text in this field before the connector runs. Keep it under ~4000 characters (engine string-variable limit).
- headers: JSON object, values may use ${expressions}. Example: {"X-Correlation-Id": "${execution.processInstanceId}"}
- jwt: Optional. Sends Authorization: Bearer &lt;token&gt;. Give the NAME of the process variable that holds the token (e.g. accessToken) - preferred, the token is read at runtime and no copy is stored in history. A token literal or the result of an expression also works. Overrides an Authorization header from Static headers / params. HTTP 401/403 -&gt; BPMN error HTTP_401 / HTTP_403.
- responseSchema: Optional JSON Schema: shapes the response (drops unknown fields) and validates it. Violation -&gt; BPMN error RESPONSE_INVALID. Paste the JSON Schema itself (inline JSON object), not a file path. Use "x-expression": "varName" (no dollar-brace wrapper) for expressions - the engine evaluates any dollar-brace text in this field before the connector runs. Keep it under ~4000 characters (engine string-variable limit).
- resultVariable: Process variable receiving the response body (stored as JSON).
- statusVariable: Process variable receiving the HTTP status code.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="url">${apiBaseUrl}/customer-snapshots</camunda:inputParameter>
          <camunda:inputParameter name="sources">profile, contact, address, preferences, account, orders, loyalty, billing, shipping, consents</camunda:inputParameter>
          <camunda:inputParameter name="paramsSchema" />
          <camunda:inputParameter name="bodySchema">{
  "type": "object",
  "required": ["customerId", "name", "contact", "address", "account", "orders", "loyalty", "consents"],
  "additionalProperties": false,
  "properties": {
    "customerId": {"type": "integer", "x-source": "/customer/id"},
    "name": {
      "type": "object",
      "required": ["first", "last"],
      "additionalProperties": false,
      "properties": {
        "first": {"type": "string", "x-source": "/customer/firstName"},
        "last": {"type": "string", "x-source": "/customer/lastName"}
      }
    },
    "birthDate": {"type": "string", "format": "date", "x-source": "/customer/birthDate"},
    "contact": {
      "type": "object",
      "required": ["email"],
      "additionalProperties": false,
      "properties": {
        "email": {"type": "string", "format": "email", "x-source": "/customer/email"},
        "phone": {"type": "string", "x-source": "/customer/phone"}
      }
    },
    "address": {
      "type": "object",
      "required": ["city", "country"],
      "additionalProperties": false,
      "properties": {
        "street": {"type": "string"},
        "city": {"type": "string"},
        "zip": {"type": "string"},
        "country": {"type": "string", "minLength": 2, "maxLength": 2}
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "language": {"type": "string"},
        "currency": {"type": "string"},
        "newsletter": {"type": "boolean"}
      }
    },
    "account": {
      "type": "object",
      "required": ["status", "tier"],
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["active", "suspended", "closed"]},
        "tier": {"type": "string", "enum": ["silver", "gold", "platinum"]}
      }
    },
    "orders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"count": {"type": "integer", "minimum": 0}, "totalSpent": {"type": "number", "minimum": 0}}
    },
    "loyalty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"points": {"type": "integer"}, "level": {"type": "string"}}
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"method": {"type": "string"}, "last4": {"type": "string", "pattern": "^[0-9]{4}$"}}
    },
    "shipping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"carrier": {"type": "string", "x-source": "/shipping/preferredCarrier"}}
    },
    "consents": {
      "type": "object",
      "required": ["marketing", "analytics"],
      "additionalProperties": false,
      "properties": {"marketing": {"type": "boolean"}, "analytics": {"type": "boolean"}}
    },
    "snapshotBy": {"type": "string", "x-expression": "execution.getVariable('initiator')", "default": "system"}
  }
}</camunda:inputParameter>
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="jwt">accessToken</camunda:inputParameter>
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable">snapshot</camunda:inputParameter>
          <camunda:inputParameter name="statusVariable">postStatus</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>toPost</bpmn:incoming>
      <bpmn:outgoing>toEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Snapshot stored">
      <bpmn:incoming>toEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="toFork" sourceRef="start" targetRef="fork" />
    <bpmn:sequenceFlow id="in_profile" sourceRef="fork" targetRef="getProfile" />
    <bpmn:sequenceFlow id="out_profile" sourceRef="getProfile" targetRef="join" />
    <bpmn:sequenceFlow id="in_contact" sourceRef="fork" targetRef="getContact" />
    <bpmn:sequenceFlow id="out_contact" sourceRef="getContact" targetRef="join" />
    <bpmn:sequenceFlow id="in_address" sourceRef="fork" targetRef="getAddress" />
    <bpmn:sequenceFlow id="out_address" sourceRef="getAddress" targetRef="join" />
    <bpmn:sequenceFlow id="in_preferences" sourceRef="fork" targetRef="getPreferences" />
    <bpmn:sequenceFlow id="out_preferences" sourceRef="getPreferences" targetRef="join" />
    <bpmn:sequenceFlow id="in_account" sourceRef="fork" targetRef="getAccount" />
    <bpmn:sequenceFlow id="out_account" sourceRef="getAccount" targetRef="join" />
    <bpmn:sequenceFlow id="in_orders" sourceRef="fork" targetRef="getOrders" />
    <bpmn:sequenceFlow id="out_orders" sourceRef="getOrders" targetRef="join" />
    <bpmn:sequenceFlow id="in_loyalty" sourceRef="fork" targetRef="getLoyalty" />
    <bpmn:sequenceFlow id="out_loyalty" sourceRef="getLoyalty" targetRef="join" />
    <bpmn:sequenceFlow id="in_billing" sourceRef="fork" targetRef="getBilling" />
    <bpmn:sequenceFlow id="out_billing" sourceRef="getBilling" targetRef="join" />
    <bpmn:sequenceFlow id="in_shipping" sourceRef="fork" targetRef="getShipping" />
    <bpmn:sequenceFlow id="out_shipping" sourceRef="getShipping" targetRef="join" />
    <bpmn:sequenceFlow id="in_consents" sourceRef="fork" targetRef="getConsents" />
    <bpmn:sequenceFlow id="out_consents" sourceRef="getConsents" targetRef="join" />
    <bpmn:sequenceFlow id="toPost" sourceRef="join" targetRef="postSnapshot" />
    <bpmn:sequenceFlow id="toEnd" sourceRef="postSnapshot" targetRef="end" />
  </bpmn:process>
