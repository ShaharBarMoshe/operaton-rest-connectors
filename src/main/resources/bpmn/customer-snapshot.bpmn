      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="url">${apiBaseUrl}/customers/{customerId}/contact</camunda:inputParameter>
          <camunda:inputParameter name="sources" />
          <camunda:inputParameter name="paramsSchema">{
  "type": "object",
  "required": ["customerId"],
  "additionalProperties": false,
  "properties": {"customerId": {"type": "integer", "minimum": 1, "x-in": "path", "x-expression": "customerId"}}
}</camunda:inputParameter>
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="jwt">accessToken</camunda:inputParameter>
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable">contact</camunda:inputParameter>
          <camunda:inputParameter name="statusVariable" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>in_contact</bpmn:incoming>
      <bpmn:outgoing>out_contact</bpmn:outgoing>
    </bpmn:serviceTask>
