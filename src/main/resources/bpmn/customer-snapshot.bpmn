        <camunda:inputOutput>
          <camunda:inputParameter name="url">${apiBaseUrl}/customers/{customerId}/contact</camunda:inputParameter>
          <camunda:inputParameter name="sources" />
          <camunda:inputParameter name="paramsSchema">- name: customerId
  in: path
  required: true
  schema:
    type: integer
    minimum: 1</camunda:inputParameter>
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable">contact</camunda:inputParameter>
          <camunda:inputParameter name="statusVariable" />
          <camunda:inputParameter name="technicalErrors">bpmnError</camunda:inputParameter>
          <camunda:inputParameter name="mockEnabled">${execution.getVariable('useMockData') == true}</camunda:inputParameter>
          <camunda:inputParameter name="mockStatus">200</camunda:inputParameter>
          <camunda:inputParameter name="mockResponse">{
  "customer": {
    "email": "noa.levi@example.com",
    "phone": "+972-50-555-0101"
  },
  "_links": {
    "self": "/api/customers/501/contact"
  }
}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>in_contact</bpmn:incoming>
      <bpmn:outgoing>out_contact</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="getAddress" name="GET address" camunda:delegateExpression="${restGet}">
