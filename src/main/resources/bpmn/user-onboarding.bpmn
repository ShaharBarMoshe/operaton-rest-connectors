        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>o5</bpmn:incoming>
      <bpmn:outgoing>o6</bpmn:outgoing>
    </bpmn:serviceTask>
    <!-- read back to prove the mock really stored PUT + PATCH -->
    <bpmn:serviceTask id="onbVerifyUser" name="GET user (verify)" camunda:delegateExpression="${restGet}">
      <bpmn:documentation>[REST connector] REST GET - Fetch data: request params built from the pasted OpenAPI parameters; 4xx -&gt; BPMN error HTTP_&lt;status&gt;.
Implementation: delegateExpression ${restGet}
Inputs (leave empty when not needed):
- url: Request URL. Supports ${expressions} and {placeholders} that are filled from params with "x-in": "path". Example: ${apiBaseUrl}/users/{userId}
- sources: Comma separated process variable names (or a JSON literal) deep-merged in order - later wins. Example: currentUser, userChanges
- paramsSchema: Paste the operation's "parameters" list from the service's OpenAPI / Swagger document (in: path | query | header). A parameter is filled from the merged sources, else from the process variable with the same name. Paste it as JSON or YAML (OpenAPI 3.x or Swagger 2.0); "$ref"s must resolve inside the pasted text, so paste the referenced components too, or the whole document plus a top-level "$ref": "#/components/schemas/Name". Add "x-source": "/json/pointer" or "x-expression": "varName" (no dollar-brace wrapper) where your process data is named differently. Long pastes (a whole OpenAPI document) work with history level activity or none; with audit / full history the engine stores every input in history and limits it to 4000 characters.
- headers: JSON object, values may use ${expressions}. Example: {"X-Correlation-Id": "${execution.processInstanceId}"}
- responseSchema: Optional. Paste the response schema from the service's OpenAPI / Swagger document: a schema object, a response, or the operation's "responses" (the first 2xx is used). Shapes the response (only declared properties are kept, writeOnly ones dropped) and validates it. Violation -&gt; BPMN error RESPONSE_INVALID. Paste it as JSON or YAML (OpenAPI 3.x or Swagger 2.0); "$ref"s must resolve inside the pasted text, so paste the referenced components too, or the whole document plus a top-level "$ref": "#/components/schemas/Name". Add "x-source": "/json/pointer" or "x-expression": "varName" (no dollar-brace wrapper) where your process data is named differently. Long pastes (a whole OpenAPI document) work with history level activity or none; with audit / full history the engine stores every input in history and limits it to 4000 characters.
- resultVariable: Process variable receiving the response body (stored as JSON).
- statusVariable: Process variable receiving the HTTP status code.
- technicalErrors: exception (default): the task fails - incident, or retried with async before. bpmnError: thrown as BPMN error HTTP_5xx / CONNECTION_FAILED so an error boundary event or error event subprocess can handle it. 4xx (HTTP_4xx) and schema errors (REQUEST_INVALID / RESPONSE_INVALID) are always BPMN errors.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="url">${apiBaseUrl}/users/{userId}</camunda:inputParameter>
          <camunda:inputParameter name="sources" />
          <camunda:inputParameter name="paramsSchema">{
  "type": "object",
  "required": ["userId", "X-Tenant"],
  "additionalProperties": false,
  "properties": {
    "userId": {"type": "integer", "minimum": 1, "x-in": "path", "x-expression": "userId"},
    "fields": {
      "type": "array",
      "items": {"type": "string", "enum": ["contact", "preferences", "roles"]},
      "uniqueItems": true,
      "x-in": "query",
      "default": ["contact", "preferences"]
    },
    "filter": {
      "type": "object",
      "x-in": "query",
      "additionalProperties": false,
      "properties": {
        "theme": {"type": "string", "x-source": "/user/preferences/theme"},
        "phone": {"type": "string", "x-source": "/user/contact/phone"}
      }
    },
    "X-Tenant": {"type": "string", "x-in": "header", "default": "acme"}
  }
}</camunda:inputParameter>
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable">finalUser</camunda:inputParameter>
          <camunda:inputParameter name="statusVariable" />
          <camunda:inputParameter name="technicalErrors">bpmnError</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>o6</bpmn:incoming>
      <bpmn:outgoing>o7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="onbEnd" name="Onboarded">
      <bpmn:incoming>o7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="onbEndNotFound" name="User not found">
      <bpmn:incoming>o404</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="o1" sourceRef="onbStart" targetRef="onbGetUser" />
    <bpmn:sequenceFlow id="o2" sourceRef="onbGetUser" targetRef="onbPutUser" />
    <bpmn:sequenceFlow id="o3" sourceRef="onbPutUser" targetRef="onbPatchPreferences" />
    <bpmn:sequenceFlow id="o4" sourceRef="onbPatchPreferences" targetRef="onbPostContact" />
    <bpmn:sequenceFlow id="o5" sourceRef="onbPostContact" targetRef="onbDeleteSessions" />
    <bpmn:sequenceFlow id="o6" sourceRef="onbDeleteSessions" targetRef="onbVerifyUser" />
    <bpmn:sequenceFlow id="o7" sourceRef="onbVerifyUser" targetRef="onbEnd" />
    <bpmn:sequenceFlow id="o404" sourceRef="onbNotFound" targetRef="onbEndNotFound" />
    <bpmn:subProcess id="errorHandler" name="Handle REST errors" triggeredByEvent="true">
      <bpmn:documentation>Catches every BPMN error thrown by a REST task of this process (error start event without an error code = catch all) and ends the instance at the end event for that kind of error. errorCode / errorMessage hold the code (HTTP_401, HTTP_404, HTTP_503, REQUEST_INVALID, CONNECTION_FAILED, ...) and the response body; callers get them with withVariablesInReturn. A boundary event on a task (e.g. HTTP_404 on the first GET) still takes precedence.</bpmn:documentation>
      <bpmn:startEvent id="errStart" name="Any REST error">
        <bpmn:outgoing>errFlowStart</bpmn:outgoing>
        <bpmn:errorEventDefinition id="errStartDef" camunda:errorCodeVariable="errorCode" camunda:errorMessageVariable="errorMessage" />
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="errKind" name="Which error?" default="errFlowRejected">
        <bpmn:incoming>errFlowStart</bpmn:incoming>
        <bpmn:outgoing>errFlowAuth</bpmn:outgoing>
        <bpmn:outgoing>errFlowNotFound</bpmn:outgoing>
        <bpmn:outgoing>errFlowInvalid</bpmn:outgoing>
        <bpmn:outgoing>errFlowUnavailable</bpmn:outgoing>
        <bpmn:outgoing>errFlowRejected</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="errEndAuth" name="Not authorized">
        <bpmn:incoming>errFlowAuth</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndNotFound" name="Not found">
        <bpmn:incoming>errFlowNotFound</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndInvalid" name="Invalid data">
        <bpmn:incoming>errFlowInvalid</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndUnavailable" name="Service unavailable">
        <bpmn:incoming>errFlowUnavailable</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="errEndRejected" name="Request rejected">
        <bpmn:incoming>errFlowRejected</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="errFlowStart" sourceRef="errStart" targetRef="errKind" />
      <bpmn:sequenceFlow id="errFlowAuth" name="HTTP_401 / HTTP_403" sourceRef="errKind" targetRef="errEndAuth">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'HTTP_401' || errorCode == 'HTTP_403'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowNotFound" name="HTTP_404" sourceRef="errKind" targetRef="errEndNotFound">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'HTTP_404'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowInvalid" name="REQUEST_INVALID / RESPONSE_INVALID" sourceRef="errKind" targetRef="errEndInvalid">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'REQUEST_INVALID' || errorCode == 'RESPONSE_INVALID'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowUnavailable" name="HTTP_5xx / CONNECTION_FAILED" sourceRef="errKind" targetRef="errEndUnavailable">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${errorCode == 'CONNECTION_FAILED' || errorCode.startsWith('HTTP_5')}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="errFlowRejected" name="other 4xx (default)" sourceRef="errKind" targetRef="errEndRejected" />
    </bpmn:subProcess>
  </bpmn:process>
