      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="url">${apiBaseUrl}/users/{userId}/sessions</camunda:inputParameter>
          <camunda:inputParameter name="sources">updatedUser</camunda:inputParameter>
          <camunda:inputParameter name="paramsSchema">{
  "type": "object",
  "required": ["userId"],
  "additionalProperties": false,
  "properties": {
    "userId": {"type": "integer", "minimum": 1, "x-in": "path", "x-source": "/user/id"},
    "reason": {"type": "string", "x-in": "query", "x-expression": "execution.getVariable('deleteReason')"}
  }
}</camunda:inputParameter>
          <camunda:inputParameter name="bodySchema" />
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable" />
          <camunda:inputParameter name="statusVariable">deleteStatus</camunda:inputParameter>
