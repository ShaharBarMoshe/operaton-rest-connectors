      }
    },
    "X-Tenant": {"type": "string", "x-in": "header", "default": "acme"}
  }
}</camunda:inputParameter>
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="jwt" />
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable">finalUser</camunda:inputParameter>
          <camunda:inputParameter name="statusVariable" />
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>o6</bpmn:incoming>
      <bpmn:outgoing>o7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="onbEnd" name="Onboarded">
      <bpmn:incoming>o7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="onbEndNotFound" name="User not found">
      <bpmn:incoming>o404</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="o1" sourceRef="onbStart" targetRef="onbGetUser" />
    <bpmn:sequenceFlow id="o2" sourceRef="onbGetUser" targetRef="onbPutUser" />
    <bpmn:sequenceFlow id="o3" sourceRef="onbPutUser" targetRef="onbPatchPreferences" />
    <bpmn:sequenceFlow id="o4" sourceRef="onbPatchPreferences" targetRef="onbPostContact" />
    <bpmn:sequenceFlow id="o5" sourceRef="onbPostContact" targetRef="onbDeleteSessions" />
    <bpmn:sequenceFlow id="o6" sourceRef="onbDeleteSessions" targetRef="onbVerifyUser" />
    <bpmn:sequenceFlow id="o7" sourceRef="onbVerifyUser" targetRef="onbEnd" />
    <bpmn:sequenceFlow id="o404" sourceRef="onbNotFound" targetRef="onbEndNotFound" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_userOnboarding">
    <bpmndi:BPMNPlane id="Plane_userOnboarding" bpmnElement="user-onboarding">
      <bpmndi:BPMNShape id="onbStart_di" bpmnElement="onbStart">
        <dc:Bounds x="152" y="102" width="36" height="36" />
