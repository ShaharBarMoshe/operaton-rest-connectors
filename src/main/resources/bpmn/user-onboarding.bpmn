      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="url">${apiBaseUrl}/contacts</camunda:inputParameter>
          <camunda:inputParameter name="sources">contactA, contactB</camunda:inputParameter>
          <camunda:inputParameter name="paramsSchema" />
          <camunda:inputParameter name="bodySchema">{
  "type": "object",
  "x-flatten": true,
  "required": ["name", "phone", "city"],
  "additionalProperties": false,
  "properties": {"name": {"type": "string"}, "phone": {"type": "number"}, "city": {"type": "string"}}
}</camunda:inputParameter>
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable">createdContact</camunda:inputParameter>
          <camunda:inputParameter name="statusVariable">postStatus</camunda:inputParameter>
          <camunda:inputParameter name="technicalErrors">bpmnError</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>o4</bpmn:incoming>
      <bpmn:outgoing>o5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="onbDeleteSessions" name="DELETE sessions" camunda:delegateExpression="${restDelete}">
