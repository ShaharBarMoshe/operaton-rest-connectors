- resultVariable: Process variable receiving the response body (stored as JSON).
- statusVariable: Process variable receiving the HTTP status code.
- technicalErrors: exception (default): the task fails - incident, or retried with async before. bpmnError: thrown as BPMN error HTTP_5xx / CONNECTION_FAILED so an error boundary event or error event subprocess can handle it. 4xx (HTTP_4xx) and schema errors (REQUEST_INVALID / RESPONSE_INVALID) are always BPMN errors.
- mockEnabled: Test mode: true = do not send the request, answer with Mock status / Mock response instead (the request is still built and validated, the response schema, error mapping and result variables work as for a real call). false or empty = real call. An expression switches it per instance, e.g. ${execution.getVariable('useMockData') == true}.
- mockStatus: HTTP status the mock answers with (default 200). A 4xx / 5xx tests the error handling, e.g. 404 -&gt; BPMN error HTTP_404.
- mockResponse: Response body the mock answers with: a JSON object / array (or text); empty = no body. ${expressions} inside are evaluated by the engine, so the mock can echo process variables.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="url">${apiBaseUrl}/users/{userId}</camunda:inputParameter>
          <camunda:inputParameter name="sources">currentUser, userChanges</camunda:inputParameter>
          <camunda:inputParameter name="paramsSchema">{
  "type": "object",
  "required": ["userId"],
  "additionalProperties": false,
  "properties": {"userId": {"type": "integer", "minimum": 1, "x-in": "path", "x-source": "/user/id"}}
}</camunda:inputParameter>
          <camunda:inputParameter name="bodySchema">{
  "type": "object",
  "required": ["user"],
  "additionalProperties": false,
  "properties": {
    "user": {
      "type": "object",
      "required": ["id", "name", "contact", "preferences"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "contact": {
          "type": "object",
          "required": ["email", "phone"],
          "additionalProperties": false,
          "properties": {
            "email": {"type": "string", "format": "email"},
            "phone": {"type": "string", "minLength": 5}
          }
        },
        "preferences": {
          "type": "object",
          "required": ["theme", "notifications"],
          "additionalProperties": false,
          "properties": {
            "theme": {"type": "string", "enum": ["light", "dark", "system"]},
            "notifications": {
              "type": "object",
              "required": ["email", "sms"],
              "additionalProperties": false,
              "properties": {
                "email": {"type": "boolean"},
                "sms": {"type": "boolean"},
                "push": {"type": "boolean"}
              }
            }
          }
        },
        "roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}</camunda:inputParameter>
          <camunda:inputParameter name="headers" />
          <camunda:inputParameter name="responseSchema" />
          <camunda:inputParameter name="resultVariable">updatedUser</camunda:inputParameter>
          <camunda:inputParameter name="statusVariable">putStatus</camunda:inputParameter>
          <camunda:inputParameter name="technicalErrors">bpmnError</camunda:inputParameter>
          <camunda:inputParameter name="mockEnabled">${execution.getVariable('useMockData') == true}</camunda:inputParameter>
          <camunda:inputParameter name="mockStatus">200</camunda:inputParameter>
          <camunda:inputParameter name="mockResponse">{
  "user": {
    "id": 1042,
    "name": "Maya Lin",
    "contact": {
      "email": "maya.lin@example.com",
      "phone": "+1-555-0148"
    },
    "preferences": {
      "theme": "dark",
      "notifications": {
        "email": true,
        "sms": true,
        "push": true
      }
    },
    "roles": [
      "editor",
      "reviewer"
    ]
  }
}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <!-- UPDATE (PATCH): flat body picked out of the merged object via x-source pointers -->
    <bpmn:serviceTask id="patchPreferences" name="UPDATE preferences" camunda:delegateExpression="${restUpdate}">
      <bpmn:documentation>[REST connector] REST UPDATE (PATCH) - Partially update a resource: body built from merged sources + pasted OpenAPI schema.
Implementation: delegateExpression ${restUpdate}
